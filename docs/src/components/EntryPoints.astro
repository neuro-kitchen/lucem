---
// The landing page's entry points, drawn as fields of view under a microscope: each row names a
// topic, says what a reader comes for, and carries a strip of nuclei outlines (generated by
// scripts/fields.mjs, not taken from an image). Hovering a row "segments" it: the outlines take
// the eosin accent.
import fields from '../data/fields.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rows = [
  { label: 'Learn', goal: 'Install lucem and run a first analysis', href: 'learn/' },
  { label: 'App', goal: 'Look at slides and volumes, build pipelines, read the results', href: 'app/' },
  { label: 'Histology', goal: 'Find tissue and cells, class them, score stains', href: 'histology/' },
  { label: 'Reference', goal: 'Look up a command, an operation or a project file', href: 'reference/' },
  { label: 'Models', goal: 'Segment nuclei with StarDist, outline objects with SAM', href: 'models/' },
  { label: 'Extend', goal: 'Write a model plugin, a script step or an operation', href: 'extend/' },
  { label: 'Deploy', goal: 'Serve images and run analyses on a lab server', href: 'deploy/' },
];
---

<nav class="fields not-content" aria-label="Where to start">
  <ul>
    {
      rows.map((e, i) => (
        <li>
          <a href={`${base}/${e.href}`} style={`--row: ${i}`}>
            <span class="label">{e.label}</span>
            <span class="goal">{e.goal}</span>
            <svg class="field" viewBox={`0 0 ${fields.width} ${fields.height}`} preserveAspectRatio="xMinYMid slice" aria-hidden="true">
              {fields.rows[i % fields.rows.length].map((d) => (
                <path d={d} pathLength="1" />
              ))}
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .fields {
    margin-block: 1.5rem 1rem;
  }
  .fields ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }
  .fields a {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) minmax(8rem, 22rem);
    align-items: center;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding-inline: 0.75rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .label {
    color: var(--sl-color-white);
    font-weight: 600;
    font-size: var(--sl-text-lg);
    letter-spacing: -0.01em;
  }
  .goal {
    font-size: var(--sl-text-base);
  }
  .field {
    width: 100%;
    height: 2.75rem;
    overflow: hidden;
  }
  .field path {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .fields a:hover,
  .fields a:focus-visible {
    background: var(--sl-color-gray-6);
  }
  .fields a:hover .label,
  .fields a:focus-visible .label {
    color: var(--sl-color-text-accent);
  }
  /* Segmented: the outlines take the accent, the nuclei a faint hematoxylin fill. */
  .fields a:hover .field path,
  .fields a:focus-visible .field path {
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
    fill: color-mix(in srgb, var(--lm-hematoxylin) 22%, transparent);
  }
  .fields a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }

  /* The one moment of motion: the outlines trace in once, field after field. */
  @media (prefers-reduced-motion: no-preference) {
    .field path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: trace 800ms ease-out forwards;
      animation-delay: calc(var(--row) * 70ms + 150ms);
    }
    @keyframes trace {
      to {
        stroke-dashoffset: 0;
      }
    }
  }

  /* Narrow screens: the field under the label and goal, full width. */
  @media (max-width: 50rem) {
    .fields a {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding-block: 0.75rem;
    }
    .field {
      height: 2.25rem;
    }
  }
</style>
